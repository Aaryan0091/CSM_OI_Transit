# Used by `npm run dev:emulator`. Points the app at the local Firebase emulators
# (`npm run emulators`) so testing never touches the real project's data.
# A "demo-" project id tells Firebase it is emulator-only.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tracker
VITE_FIREBASE_STORAGE_BUCKET=demo-tracker.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_APP_URL=

# Throwaway emulator-only test login (wiped when the emulators stop):
# TEST_SALES_EMAIL=sales.tester@example.test
# TEST_SALES_PASSWORD=Tst-1eabac5d83f0
# TEST_DESIGN_EMAIL=design.tester@example.test
