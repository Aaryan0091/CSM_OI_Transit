rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.admin == true;
    }

    function isDepartment(value) {
      return value in ['Sales', 'Design', 'Procurement', 'Production', 'QC', 'Dispatch'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasOnly(['name', 'email', 'dept']) &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.email is string &&
        data.email.size() > 3 &&
        data.dept is string &&
        (isDepartment(data.dept) || (isAdmin() && data.dept == 'Admin'));
    }

    function isOwnProfile(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDepartment() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dept;
    }

    function currentUserName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
    }

    match /users/{userId} {
      allow read: if (isVerified() && isOwnProfile(userId)) || isAdmin();

      allow create: if isOwnProfile(userId) &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.dept != 'Admin';

      allow update: if
        (isAdmin() && isValidUserProfile(request.resource.data)) ||
        (
          isVerified() &&
          isOwnProfile(userId) &&
          isValidUserProfile(request.resource.data) &&
          request.resource.data.dept == resource.data.dept
        );

      allow delete: if isAdmin();
    }

    function isValidTask(task, expectedDepartment) {
      return task.keys().hasOnly([
          'dept',
          'status',
          'assignee',
          'remark',
          'nextDeptRemark',
          'nextDeptRemarkTarget',
          'holdReason'
        ]) &&
        task.dept == expectedDepartment &&
        task.status in ['In Progress', 'On Hold', 'Completed', 'Dispatched'] &&
        task.assignee is string &&
        task.assignee.size() <= 200 &&
        task.remark is string &&
        task.remark.size() <= 5000 &&
        task.nextDeptRemark is string &&
        task.nextDeptRemark.size() <= 5000 &&
        task.nextDeptRemarkTarget is string &&
        (task.nextDeptRemarkTarget == '' || isDepartment(task.nextDeptRemarkTarget)) &&
        task.holdReason is string &&
        task.holdReason.size() <= 5000 &&
        (task.status != 'On Hold' || task.holdReason.size() > 0);
    }

    function hasValidOverallStatus(data) {
      return (
          data.tasks[0].status in ['Completed', 'Dispatched'] &&
          data.tasks[1].status in ['Completed', 'Dispatched'] &&
          data.tasks[2].status in ['Completed', 'Dispatched'] &&
          data.tasks[3].status in ['Completed', 'Dispatched'] &&
          data.tasks[4].status in ['Completed', 'Dispatched'] &&
          data.tasks[5].status in ['Completed', 'Dispatched'] &&
          data.overallStatus == 'Completed'
        ) || (
          (
            data.tasks[0].status == 'On Hold' ||
            data.tasks[1].status == 'On Hold' ||
            data.tasks[2].status == 'On Hold' ||
            data.tasks[3].status == 'On Hold' ||
            data.tasks[4].status == 'On Hold' ||
            data.tasks[5].status == 'On Hold'
          ) &&
          data.overallStatus == 'On Hold'
        ) || (
          !(data.tasks[0].status in ['Completed', 'Dispatched'] &&
            data.tasks[1].status in ['Completed', 'Dispatched'] &&
            data.tasks[2].status in ['Completed', 'Dispatched'] &&
            data.tasks[3].status in ['Completed', 'Dispatched'] &&
            data.tasks[4].status in ['Completed', 'Dispatched'] &&
            data.tasks[5].status in ['Completed', 'Dispatched']) &&
          data.tasks[0].status != 'On Hold' &&
          data.tasks[1].status != 'On Hold' &&
          data.tasks[2].status != 'On Hold' &&
          data.tasks[3].status != 'On Hold' &&
          data.tasks[4].status != 'On Hold' &&
          data.tasks[5].status != 'On Hold' &&
          data.overallStatus == 'In Progress'
        );
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasOnly([
          'id',
          'company',
          'client',
          'product',
          'description',
          'deadline',
          'priority',
          'overallStatus',
          'tasks',
          'createdAt',
          'lastActivityId'
        ]) &&
        data.id == orderId &&
        data.company in ['CSM', 'Oriental'] &&
        data.client is string &&
        data.client.size() > 0 &&
        data.client.size() <= 300 &&
        data.product is string &&
        data.product.size() > 0 &&
        data.product.size() <= 300 &&
        data.description is string &&
        data.description.size() <= 5000 &&
        data.deadline is string &&
        data.deadline.size() > 0 &&
        data.priority in ['Low', 'Medium', 'High', 'Critical'] &&
        data.createdAt is string &&
        data.lastActivityId is string &&
        data.lastActivityId.size() > 0 &&
        data.tasks is list &&
        data.tasks.size() == 6 &&
        isValidTask(data.tasks[0], 'Sales') &&
        isValidTask(data.tasks[1], 'Design') &&
        isValidTask(data.tasks[2], 'Procurement') &&
        isValidTask(data.tasks[3], 'Production') &&
        isValidTask(data.tasks[4], 'QC') &&
        isValidTask(data.tasks[5], 'Dispatch') &&
        hasValidOverallStatus(data);
    }

    function departmentIndex(department) {
      return department == 'Sales' ? 0 :
        department == 'Design' ? 1 :
        department == 'Procurement' ? 2 :
        department == 'Production' ? 3 :
        department == 'QC' ? 4 :
        department == 'Dispatch' ? 5 : -1;
    }

    function onlyDepartmentTaskChanged(before, after, department) {
      let editableIndex = departmentIndex(department);
      return isDepartment(department) &&
        (editableIndex == 0 || before.tasks[0] == after.tasks[0]) &&
        (editableIndex == 1 || before.tasks[1] == after.tasks[1]) &&
        (editableIndex == 2 || before.tasks[2] == after.tasks[2]) &&
        (editableIndex == 3 || before.tasks[3] == after.tasks[3]) &&
        (editableIndex == 4 || before.tasks[4] == after.tasks[4]) &&
        (editableIndex == 5 || before.tasks[5] == after.tasks[5]);
    }

    function isValidDepartmentUpdate(data, department) {
      return isDepartment(department) &&
        data.lastActivityId is string &&
        data.lastActivityId.size() > 0 &&
        data.tasks is list &&
        data.tasks.size() == 6 &&
        isValidTask(data.tasks[departmentIndex(department)], department) &&
        hasValidOverallStatus(data);
    }

    function hasNewMatchingActivity(data, orderId) {
      let activityPath = /databases/$(database)/documents/orders/$(orderId)/activity/$(data.lastActivityId);
      return !exists(activityPath) && existsAfter(activityPath);
    }

    function isValidActivity(data, orderId) {
      return data.keys().hasOnly([
          'actorUid',
          'actorName',
          'actorDept',
          'action',
          'summary',
          'createdAt'
        ]) &&
        data.actorUid == request.auth.uid &&
        data.actorName == currentUserName() &&
        data.actorDept == (isAdmin() ? 'Admin' : currentUserDepartment()) &&
        data.action == (
          exists(/databases/$(database)/documents/orders/$(orderId))
            ? 'updated'
            : 'created'
        ) &&
        data.summary is string &&
        data.summary.size() > 0 &&
        data.summary.size() <= 5000 &&
        data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow read: if isVerified();
      allow create: if isAdmin() &&
        isValidOrder(request.resource.data, orderId) &&
        hasNewMatchingActivity(request.resource.data, orderId);
      allow update: if hasNewMatchingActivity(request.resource.data, orderId) && (
        (isAdmin() && isValidOrder(request.resource.data, orderId)) ||
        (
          isVerified() &&
          isValidDepartmentUpdate(
            request.resource.data,
            currentUserDepartment()
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'tasks',
            'overallStatus',
            'lastActivityId'
          ]) &&
          onlyDepartmentTaskChanged(
            resource.data,
            request.resource.data,
            currentUserDepartment()
          )
        )
      );
      allow delete: if isAdmin();

      match /activity/{activityId} {
        allow read: if isVerified();
        allow create: if isVerified() &&
          isValidActivity(request.resource.data, orderId) &&
          getAfter(/databases/$(database)/documents/orders/$(orderId)).data.lastActivityId == activityId;
        allow update, delete: if false;
      }
    }

    function isValidAdminRequest(data) {
      return data.keys().hasOnly([
          'requesterUid',
          'requesterEmail',
          'requesterName',
          'requesterDept',
          'status',
          'createdAt',
          'approvedAt',
          'approvedBy'
        ]) &&
        data.requesterUid is string &&
        data.requesterEmail is string &&
        data.requesterName is string &&
        data.requesterDept is string &&
        isDepartment(data.requesterDept) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is string;
    }

    match /adminRequests/{requestId} {
      allow read: if isAdmin() || (isVerified() && resource.data.requesterUid == request.auth.uid);

      allow create: if isVerified() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.approvedAt == null &&
        request.resource.data.approvedBy == null &&
        isValidAdminRequest(request.resource.data);

      allow update: if isAdmin() && isValidAdminRequest(request.resource.data);

      allow delete: if isAdmin();
    }
  }
}
